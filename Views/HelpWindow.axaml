<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EyeBrowse.Views.HelpWindow"
        Background="Black" Foreground="Chartreuse"
        Icon="/Assets/eyebrowse.ico"
        Title="EyeBrowse"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#DFFFBF" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="#B8D99A" />
        </Style>
        <Style Selector="Grid.keys TextBlock">
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Grid.keys TextBlock.key">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#DFFFBF" />
        </Style>
        <!-- A setting: outlined when it's the one Space changes, like the overlay's modes. -->
        <Style Selector="Border.setting">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.setting.selected">
            <Setter Property="BorderBrush" Value="Chartreuse" />
            <Setter Property="Background" Value="#247FFF00" />
        </Style>
        <Style Selector="Border.box">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="BorderBrush" Value="Chartreuse" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="24,20">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Image Source="/Assets/eyebrowse-512.png" Width="56" Height="56" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="EyeBrowse" FontSize="22" FontWeight="Bold" />
                <TextBlock Classes="note" Text="A full-screen image browser." />
            </StackPanel>
        </StackPanel>

        <!-- Shown only when EyeBrowse was given something it couldn't open. -->
        <Border x:Name="ErrorPanel" IsVisible="False" Margin="0,16,0,0" Padding="10,8"
                Background="#33FF4040" BorderBrush="#FF6060" BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="ErrorText" Foreground="#FFB0B0" />
        </Border>

        <TextBlock Classes="heading" Text="How to use" />
        <TextBlock Text="Open an image with EyeBrowse, for example with right-click, Open with, or run:" />
        <TextBlock Text="EyeBrowse &lt;image, folder or archive&gt;" FontFamily="monospace" Margin="0,6,0,0" Foreground="#DFFFBF" />
        <TextBlock Classes="note" Margin="0,6,0,0"
                   Text="It shows that image full screen, and you can step through the other images in the same folder, or the pages of a comic book archive." />

        <TextBlock Classes="heading" Text="Keys" />
        <Grid Classes="keys" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Classes="key" Text="Q  /  E" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Previous / next image (or pair); with Shift, first / last" />
            <TextBlock Grid.Row="1" Classes="key" Text="W A S D" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Pan" />
            <TextBlock Grid.Row="2" Classes="key" Text="Z" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Fill the screen" />
            <TextBlock Grid.Row="3" Classes="key" Text="X" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Fit to the screen" />
            <TextBlock Grid.Row="4" Classes="key" Text="C" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="True size" />
            <TextBlock Grid.Row="5" Classes="key" Text="1" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="One page" />
            <TextBlock Grid.Row="6" Classes="key" Text="2" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="Two pages; press again to shift the pairs" />
            <TextBlock Grid.Row="7" Classes="key" Text="R" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="Right to left, for manga" />
            <TextBlock Grid.Row="8" Classes="key" Text="Tab" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="Show / hide the file name and modes" />
            <TextBlock Grid.Row="9" Classes="key" Text="H  F1  ?" />
            <TextBlock Grid.Row="9" Grid.Column="1" Text="This help" />
            <TextBlock Grid.Row="10" Classes="key" Text="Esc" />
            <TextBlock Grid.Row="10" Grid.Column="1" Text="Quit" />
        </Grid>
        <TextBlock Classes="note" Margin="0,8,0,0"
                   Text="EyeBrowse is keyboard-only: the arrow keys and mouse clicks just open this help." />

        <TextBlock Classes="heading" Text="Settings" />
        <Border x:Name="KeepPanRow" Classes="setting selected">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="box">
                    <Path x:Name="KeepPanCheck" Stroke="Chartreuse" StrokeThickness="2" Data="M3 7 L6 10 L11 3" />
                </Border>
                <TextBlock Text="Keep the pan position when changing page" />
            </StackPanel>
        </Border>
        <TextBlock Classes="note" Margin="0,6,0,0"
                   Text="Space changes the outlined setting. Z X C, 1 2 (for comics and folders apart) and Tab are remembered too. EyeBrowse keeps no history of the files you open." />

        <TextBlock Classes="note" Margin="0,16,0,0" FontSize="11"
                   Text="Images: PNG, JPEG, BMP, GIF, TIFF and WebP. Archives: .cbz and .zip, and .cbr, .cb7 or .cbt files that are really zips. Press Esc to close this window. Press A for About and licences." />
    </StackPanel>
</Window>
